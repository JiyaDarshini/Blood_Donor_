# Neon PostgreSQL Connection URL
# Replace with your Neon connection string:
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-proj-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./blood_sos.db

# JWT Configuration
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Application Configuration
POINTS_PER_VERIFIED_DONATION=100
DONOR_SEARCH_RADIUS_KM=25

# Email SMTP Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=notifications@bloodsos.org
SMTP_TLS=True

# SMS Configuration (Optional)
SMS_PROVIDER=none
SMS_API_KEY=

# Server Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=*
